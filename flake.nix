{
  description = "Pressure Well: a paintable pattern table that is also a real synthesizer, and the checks that keep the aliasing claim honest";

  # The same revision flux-pond pins, so the binary cache and the Chromium that
  # the browser checks drive are shared across the org rather than drifting per
  # repo. All seven repos that carry a flake pin this one.
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/5e867b1db0f219e0e906574cca1175f421a87834";

  outputs =
    { nixpkgs, ... }:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};

      # esbuild and jsdom exist nowhere in nixpkgs, so the two Node libraries the
      # checks import are fetched from npm against package-lock.json.
      # importNpmLock needs no hash: the integrity fields in the lock are the check.
      nodeModules = pkgs.importNpmLock.buildNodeModules {
        npmRoot = ./.;
        inherit (pkgs) nodejs;
      };

      # Everything the checks need on the environment. The app itself needs a
      # browser and nothing else.
      checkEnv = {
        # The browser check resolves Playwright from this absolute path, because
        # ESM ignores NODE_PATH.
        PLAYWRIGHT_ENTRY = "${pkgs.playwright}/index.js";
        PLAYWRIGHT_BROWSERS_PATH = "${pkgs.playwright-driver.browsers}";
        # importNpmLock's output root holds `node_modules` itself, and it links the
        # platform binary esbuild's JS API spawns, so nothing downloads at build
        # time and esbuild's own version stays self-consistent. (Pointing
        # ESBUILD_BINARY_PATH at nixpkgs' esbuild instead breaks: the JS API and the
        # binary speak a versioned protocol, and 0.27.7 versus 0.27.2 is
        # "The service was stopped".)
        NODE_PATH = "${nodeModules}/node_modules";
      };

      # The browser-free half: the synth DSP, the score model, and a byte-for-byte
      # comparison of index.html against a fresh build from src/. That last check is
      # what makes a stale generated page a build failure rather than a preview that
      # silently shows somebody else's code.
      tests = pkgs.runCommand "pressure-well-tests"
        {
          nativeBuildInputs = [ pkgs.nodejs ];
          src = pkgs.lib.fileset.toSource {
            root = ./.;
            fileset = pkgs.lib.fileset.unions [
              ./package.json
              ./package-lock.json
              ./src
              ./tests
              ./tools
              ./README.md
              ./docs
              # index.html is generated by tools/build.mjs and gitignored, so it
              # may legitimately be absent in a fresh clone. maybeMissing keeps it
              # in the fileset when present -- the byte-comparison test needs it --
              # without making the build depend on a file that is not in Git.
              (pkgs.lib.fileset.maybeMissing ./index.html)
            ];
          };
        }
        ''
          set -euo pipefail
          # check.sh skips a layer whose library is missing rather than failing,
          # which is right on a laptop and a silent green in a build where the
          # libraries are pinned by package-lock.json. Here a skip is a broken
          # shell. $src is read-only, so the log goes in the build directory.
          checkLog=$PWD/check.log
          cd $src
          status=0
          NODE_PATH="${nodeModules}/node_modules" bash tools/check.sh > "$checkLog" 2>&1 || status=$?
          cat "$checkLog"
          if [ $status -ne 0 ]; then
            echo "pressure-well: tools/check.sh exited $status" >&2
            exit $status
          fi
          if grep -q SKIP "$checkLog"; then
            echo "pressure-well: a test layer skipped, so NODE_PATH is not serving esbuild and jsdom" >&2
            exit 1
          fi
          touch $out
        '';
    in
    {
      packages.${system}.default = tests;

      checks.${system}.default = tests;

      # The browser half is deliberately not a `checks` entry: it needs
      # --no-sandbox, a writable directory for the screenshots it writes, and real
      # wall-clock playback, which no sandboxed build should be asked to guarantee.
      # `nix flake check` is the browser-free half; CI runs the browser half here.
      devShells.${system}.default = pkgs.mkShell {
        packages = [
          pkgs.git
          pkgs.nodejs
          pkgs.playwright-driver.browsers
          pkgs.python3
        ];
        env = checkEnv;
        shellHook = ''
          echo "Pressure Well: bash tools/check.sh --browser   (or: nix flake check)"
        '';
      };
    };
}
